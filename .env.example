# SMTP credentials used by /api/contact to send enquiry emails.
# Copy this file to .env.local and fill in real values before deploying.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Optional: override which inbox enquiries are delivered to.
# Defaults to the email set in src/lib/site-config.ts.
CONTACT_TO_EMAIL=hello@cakesbybims.co.uk
